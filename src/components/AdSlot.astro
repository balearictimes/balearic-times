---
// Star FM-style ad slot. When you join Google AdSense, set PUBLIC_ADSENSE_CLIENT (e.g. ca-pub-123…)
// and a slot id per placement; until then nothing is shown except a little breathing room.
import { uiOf } from '../i18n';
interface Props { slot?: string; variant?: 'incontent' | 'inarticle'; lang?: string }
const { slot = '', variant = 'incontent', lang = 'en' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
---
{client && slot ? (
  <div class={`ad-slot ad-${variant}`}>
    <span class="ad-label">{uiOf(lang).advertisement}</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : (
  <div class={`ad-slot ad-${variant}`} aria-hidden="true"></div>
)}
