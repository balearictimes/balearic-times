---
import CategoryPage from '../../../../../components/CategoryPage.astro';
import { categoryPaths } from '../../../../../data/routes';
import { OTHER_LANGS } from '../../../../../i18n';
export async function getStaticPaths() {
  return (await Promise.all(OTHER_LANGS.map((l) => categoryPaths(l.code, true)))).flat();
}
const { cat, n, lang } = Astro.params;
const { items, pages } = Astro.props;
---
<CategoryPage cat={cat!} items={items} page={Number(n)} pages={pages} lang={lang} />
