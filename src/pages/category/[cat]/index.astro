---
import CategoryPage from '../../../components/CategoryPage.astro';
import { categoryPaths } from '../../../data/routes';
export const getStaticPaths = () => categoryPaths('en', false);
const { cat } = Astro.params;
const { items, pages } = Astro.props;
---
<CategoryPage cat={cat!} items={items} page={1} pages={pages} lang="en" />
